<%- include('partials/header') %>

<main class="container mt-5 pt-4">
    <div class="row align-items-center mt-5 mb-5">
        
        <!-- Left Side: Text and Badges -->
        <div class="col-lg-7 order-2 order-lg-1 mt-5 mt-lg-0 text-center text-lg-start">
            <h1 class="display-4 fw-bold mb-3">Hi, I'm Muhammad Soban Ajmal <span class="wave">👋</span></h1>
            <h4 class="text-secondary mb-4">Networking & IT Security Student</h4>
            <p class="lead text-muted mb-4">
                I build secure infrastructure and modern web applications. From configuring custom hardware and IPv6 and IPV4 topologies to developing responsive interfaces with Angular, I love connecting the dots between hardware and software. 
            </p>
            
            <!-- Skill Badges -->
            <div class="d-flex gap-2 mb-4 flex-wrap justify-content-center justify-content-lg-start">
                <span class="badge bg-dark p-2 fs-6"><i class="fa-solid fa-network-wired"></i> Infrastructure</span>
                <span class="badge bg-dark p-2 fs-6"><i class="fa-solid fa-shield-halved"></i> IT Security</span>
                <span class="badge bg-dark p-2 fs-6"><i class="fa-brands fa-angular"></i> Angular</span>
                <span class="badge bg-dark p-2 fs-6"><i class="fa-solid fa-microchip"></i> Hardware</span>
            </div>
            
            <!-- Buttons -->
            <div class="d-flex gap-3 mt-4 justify-content-center justify-content-lg-start">
                <a href="/projects" class="btn btn-dark btn-lg px-4 shadow-sm rounded-pill">View My Work</a>
                <a href="/about" class="btn btn-outline-dark btn-lg px-4 shadow-sm rounded-pill">More About Me</a>
            </div>
        </div>
        
        <!-- Right Side: Bitmoji/Avatar Placeholder -->
        <div class="col-lg-5 order-1 order-lg-2 text-center">
            <div class="position-relative d-inline-block">
                <!-- This links directly to the image you place in public/images -->
                <img src="/images/bitmoji.png" alt="My Bitmoji" class="img-fluid rounded-circle shadow-lg" style="max-width: 350px; background-color: #f8f9fa; border: 5px solid white;">
                
                <!-- Floating decorative icon -->
                <div class="position-absolute bottom-0 end-0 bg-white p-3 rounded-circle shadow" style="transform: translate(10%, 10%);">
                    <i class="fa-solid fa-code fs-3 text-dark"></i>
                </div>
            </div>
        </div>

    </div>
</main>

<%- include('partials/footer') %>
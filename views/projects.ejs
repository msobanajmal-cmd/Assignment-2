<%- include('partials/header') %>

<main class="container mt-5">
    <h1 class="mb-5 text-center"><%= title %></h1>
    
    <div class="row">
        <!-- Project 1: Networking -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">IPv6 Network Topology</h5>
                    <h6 class="card-subtitle mb-3 text-muted">Networking Infrastructure</h6>
                    <p class="card-text">
                        Designed a comprehensive network topology diagram and developed a complete IPv6 addressing table as part of Case Study Group.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <span class="badge bg-primary">Networking</span>
                    <span class="badge bg-secondary">IPv6</span>
                </div>
            </div>
        </div>

        <!-- Project 2: Case Study -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Best Buy Turnaround Analysis</h5>
                    <h6 class="card-subtitle mb-3 text-muted">Corporate Strategy</h6>
                    <p class="card-text">
                        Collaborated on a detailed group presentation analyzing Hubert Joly's corporate turnaround strategy at Best Buy, evaluating servant and ethical leadership principles in business.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <span class="badge bg-primary">Business Analysis</span>
                    <span class="badge bg-secondary">Leadership</span>
                </div>
            </div>
        </div>

        <!-- Project 3: Web Dev -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Angular Web Applications</h5>
                    <h6 class="card-subtitle mb-3 text-muted">Frontend Development</h6>
                    <p class="card-text">
                        Built modern web components utilizing the Angular Signals API, standalone components, and modern control flow syntax to create responsive interfaces.
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <span class="badge bg-primary">Angular</span>
                    <span class="badge bg-secondary">Web Development</span>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>